        "minor": "#4b5563",
        "medium": "#b45309",
        "high": "#c2410c",
        "critical": "#991b1b"
      }
    },
    "dark": {
      "background": "#0b0f14",
      "surface": "#111827",
      "surfaceElevated": "#1f2937",
      "text": "#f3f4f6",
