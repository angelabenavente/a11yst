{
  "meta": {
    "product": "a11yst",
    "version": "1.0.0",
    "description": "Design tokens for a11yst website and documentation (P4 foundation)."
  },
  "color": {
    "light": {
      "background": "#f8f9fb",
      "surface": "#ffffff",
      "surfaceElevated": "#ffffff",
      "text": "#111827",
