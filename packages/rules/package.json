{
  "name": "@a11yst/rules",
  "version": "1.0.2",
  "description": "a11yst accessibility rule definitions and evaluation utilities",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@a11yst/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelabenavente/a11yst.git"
  },
  "homepage": "https://www.a11yst.dev",
  "bugs": {
    "url": "https://github.com/angelabenavente/a11yst/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
