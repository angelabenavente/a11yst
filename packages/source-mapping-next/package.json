{
  "name": "@a11yst/source-mapping-next",
  "version": "1.0.0",
  "description": "Conservative Next.js static route catalog and source mapping for a11yst",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@a11yst/source-index": "workspace:*",
    "@a11yst/source-mapping": "workspace:*",
    "@a11yst/source-mapping-react": "workspace:*",
    "@a11yst/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelabenavente/a11yst.git"
  },
  "homepage": "https://github.com/angelabenavente/a11yst#readme",
  "bugs": {
    "url": "https://github.com/angelabenavente/a11yst/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
