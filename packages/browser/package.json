{
  "name": "@a11yst/browser",
  "version": "1.0.0",
  "description": "Playwright + axe-core web audit engine for a11yst",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@a11yst/adapters": "workspace:*",
    "@a11yst/flows": "workspace:*",
    "@a11yst/profiles": "workspace:*",
    "@a11yst/rules": "workspace:*",
    "@a11yst/types": "workspace:*",
    "@axe-core/playwright": "^4.10.1",
    "playwright": "1.62.0",
    "playwright-core": "1.62.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MPL-2.0"
}
