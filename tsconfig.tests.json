{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@a11yst/types": ["./packages/types/src/index.ts"],
      "@a11yst/config": ["./packages/config/src/index.ts"],
      "@a11yst/core": ["./packages/core/src/index.ts"],
      "@a11yst/detect": ["./packages/detect/src/index.ts"],
      "@a11yst/browser": ["./packages/browser/src/index.ts"],
      "@a11yst/cli": ["./packages/cli/src/index.ts"],
      "@a11yst/artifacts": ["./packages/artifacts/src/index.ts"],
      "@a11yst/reporters": ["./packages/reporters/src/index.ts"],
      "@a11yst/adapters": ["./packages/adapters/src/index.ts"],
      "@a11yst/profiles": ["./packages/profiles/src/index.ts"],
      "@a11yst/rules": ["./packages/rules/src/index.ts"],
      "@a11yst/baseline": ["./packages/baseline/src/index.ts"],
      "@a11yst/policy": ["./packages/policy/src/index.ts"],
      "@a11yst/sarif": ["./packages/sarif/src/index.ts"],
