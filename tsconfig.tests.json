      "@a11yst/source-mapping-nuxt": ["./packages/source-mapping-nuxt/src/index.ts"],
      "@a11yst/source-mapping-angular": ["./packages/source-mapping-angular/src/index.ts"],
      "@a11yst/source-ranking": ["./packages/source-ranking/src/index.ts"],
      "@a11yst/recommendations": ["./packages/recommendations/src/index.ts"],
      "@a11yst/source-analysis": ["./packages/source-analysis/src/index.ts"]
