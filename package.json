{
  "name": "a11yst-monorepo",
  "private": true,
  "version": "1.0.1",
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "ci:quality": "pnpm build && pnpm typecheck && pnpm lint && pnpm test:unit",
    "ci:integration": "vitest run --config vitest.integration.config.ts tests/integration/regression tests/integration/cli/cli.test.ts tests/integration/cli/report-cli.test.ts tests/integration/source-analysis/core-policy.test.ts tests/integration/browser/audit-engine.test.ts",
    "audit:published": "node scripts/audit-published-dependencies.mjs",
    "ci:release": "pnpm audit:published",
    "a11yst": "node packages/cli/dist/bin.js",
    "demo": "node examples/demo/a11yst-shop/scripts/demo.mjs",
    "clean": "pnpm -r --filter './packages/*' run clean && rm -rf node_modules/.vite coverage"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "playwright": "1.62.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "ajv": "^6.12.6",
    "fast-xml-parser": "^4.5.1",
    "vitest": "^2.1.9",
    "yaml": "^2.7.0"
  }
}
